# Copy to .env and adjust for your environment. Never commit real secrets.
# Read by docker-compose.yml; the Spring Boot app reads the same names as OS env vars.
# Defaults already match docker-compose.yml, so a plain local run needs no overrides.

EVENTCART_DB_HOST=localhost
EVENTCART_DB_PORT=5439
EVENTCART_DB_NAME=eventcart
EVENTCART_DB_USER=eventcart
EVENTCART_DB_PASSWORD=eventcart

EVENTCART_KAFKA_PORT=9092
EVENTCART_KAFKA_UI_PORT=8095
EVENTCART_KAFKA_BOOTSTRAP=localhost:9092
